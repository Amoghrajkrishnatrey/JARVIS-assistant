# Copy this file to .env and fill in what you need.
# JARVIS works fully offline with Ollama; the cloud variables are optional.

# --- LLM backend selection ------------------------------------------------
# "ollama" (default, local) or "cloud"
JARVIS_LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_BASE_URL=http://localhost:11434

# Used automatically if Ollama is unreachable, or always if JARVIS_LLM_BACKEND=cloud
JARVIS_CLOUD_PROVIDER=anthropic        # "anthropic" or "openai"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Voice -----------------------------------------------------------------
JARVIS_VOICE_ENABLED=true
JARVIS_SPEECH_RATE=165
JARVIS_SPEECH_MAX_CHARS=400

# --- Paths -------------------------------------------------------------------
JARVIS_WORKSPACE=./jarvis_workspace
JARVIS_DATA_DIR=./jarvis_workspace/data
JARVIS_VECTOR_STORE=./jarvis_workspace/chroma_db

# --- Sandbox -----------------------------------------------------------------
JARVIS_EXEC_TIMEOUT=20

# --- Optional legacy utility ---------------------------------------------
OPENWEATHER_API_KEY=
